# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env staat in .gitignore en wordt nooit gecommit.

# Te vinden op sanity.io/manage → je project
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Alleen nodig voor het seed-script (scripts/seed.ts).
# Aanmaken via sanity.io/manage → project → API → Tokens → "Editor"-rechten.
# Nooit delen, nooit committen.
SANITY_API_WRITE_TOKEN=

# Staat op "false" (of leeg) zolang de site op een tijdelijke
# vercel.app-URL staat, zodat zoekmachines niet indexeren. Zet op
# "true" zodra saveursavoir.nl aan deze site gekoppeld is.
PUBLIC_ALLOW_INDEXING=false

# Contactformulier (web3forms.com). Access key aanmaken via
# web3forms.com — gratis, alleen een e-mailadres nodig. Deze key is
# bedoeld om publiek in de HTML te staan (vandaar PUBLIC_).
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Shopify Storefront API (productetalage + winkelwagen op /webshop). Zie
# de "Shopify-koppeling"-sectie in README.md voor hoe je dit aanmaakt.
# Zonder deze twee variabelen toont /webshop een nette "binnenkort"-
# melding — geen build-fout. PUBLIC_ omdat de winkelwagen client-side
# rechtstreeks met de Storefront API praat.
PUBLIC_SHOPIFY_DOMAIN=
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
