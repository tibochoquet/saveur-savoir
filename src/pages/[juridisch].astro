---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import PortableText from "../components/PortableText.astro";
import { getJuridischePagina, type JuridischePaginaId } from "../sanity/lib/queries";

export async function getStaticPaths() {
  // Moet hier lokaal staan: getStaticPaths draait in een geïsoleerde
  // scope en heeft geen toegang tot losse top-level constantes elders
  // in dit bestand.
  const routes: { slug: string; id: JuridischePaginaId }[] = [
    { slug: "disclaimer", id: "disclaimer" },
    { slug: "privacybeleid", id: "privacybeleid" },
    { slug: "herroeping", id: "herroeping" },
    { slug: "algemene-voorwaarden", id: "algemeneVoorwaarden" },
    { slug: "verzenden-retourneren", id: "verzendenRetourneren" },
    { slug: "cookievoorkeuren", id: "cookievoorkeuren" },
    { slug: "servicevoorwaarden", id: "servicevoorwaarden" },
  ];
  return routes.map((route) => ({ params: { juridisch: route.slug }, props: { docId: route.id } }));
}

const { docId } = Astro.props as { docId: JuridischePaginaId };
const pagina = await getJuridischePagina(docId);
---

<Layout
  title={pagina?.seoTitel || `${pagina?.titel ?? "Pagina"} — Saveur & Savoir`}
  description={pagina?.seoOmschrijving || pagina?.titel}
>
  <Header />

  <Section spacing="lg" tone="cream">
    <Container class="max-w-2xl">
      <h1 class="font-serif text-4xl text-ink-900 sm:text-5xl">
        {pagina?.titel}
      </h1>
      <div class="mt-8">
        {
          pagina?.inhoud?.length ? (
            <PortableText value={pagina.inhoud} class="text-base text-ink-700" />
          ) : (
            <p class="text-base text-ink-500">Deze pagina wordt binnenkort aangevuld.</p>
          )
        }
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
