---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import PortableText from "../components/PortableText.astro";
import { getJuridischePagina, type JuridischePaginaId } from "../sanity/lib/queries";

export async function getStaticPaths() {
  // Moet hier lokaal staan: getStaticPaths draait in een geïsoleerde
  // scope en heeft geen toegang tot losse top-level constantes elders
  // in dit bestand.
  const routes: { slug: string; id: JuridischePaginaId }[] = [
    { slug: "disclaimer", id: "disclaimer" },
    { slug: "privacybeleid", id: "privacybeleid" },
    { slug: "herroeping", id: "herroeping" },
    { slug: "algemene-voorwaarden", id: "algemeneVoorwaarden" },
    { slug: "verzenden-retourneren", id: "verzendenRetourneren" },
    { slug: "cookievoorkeuren", id: "cookievoorkeuren" },
    { slug: "servicevoorwaarden", id: "servicevoorwaarden" },
  ];
  return routes.map((route) => ({ params: { juridisch: route.slug }, props: { docId: route.id } }));
}

const { docId } = Astro.props as { docId: JuridischePaginaId };
const pagina = await getJuridischePagina(docId);
---

<Layout
  title={pagina?.seoTitel || `${pagina?.titel ?? "Pagina"} — Saveur & Savoir`}
  description={pagina?.seoOmschrijving || pagina?.titel}
>
  <Header />

  <Section spacing="lg" tone="cream">
    <Container class="max-w-2xl">
      <h1 class="font-serif text-4xl text-ink-900 sm:text-5xl">
        {pagina?.titel}
      </h1>
      <div class="mt-8">
        {
          pagina?.inhoud?.length ? (
            <PortableText value={pagina.inhoud} class="text-base text-ink-700" />
          ) : (
            <p class="text-base text-ink-500">Deze pagina wordt binnenkort aangevuld.</p>
          )
        }
      </div>

      {
        docId === "cookievoorkeuren" && (
          <div class="mt-10 border border-blue-200 bg-cream-50 p-6" id="cookie-status-block">
            <p class="text-sm font-medium text-ink-900">
              Je huidige voorkeur: <span id="cookie-status-text">nog geen keuze gemaakt</span>
            </p>
            <button
              type="button"
              id="cookie-status-change"
              class="mt-4 inline-flex items-center gap-2 border border-terracotta-500 bg-terracotta-500 px-6 py-3 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:border-terracotta-600 hover:bg-terracotta-600"
            >
              Wijzig je cookievoorkeuren
            </button>
          </div>
        )
      }
    </Container>
  </Section>

  <Footer />
</Layout>

<script>
  import { getStoredConsent } from "../lib/consent";

  const statusText = document.getElementById("cookie-status-text");
  const changeButton = document.getElementById("cookie-status-change");

  function renderStatus() {
    if (!statusText) return;
    const consent = getStoredConsent();
    statusText.textContent =
      consent === "granted"
        ? "analytische cookies geaccepteerd"
        : consent === "denied"
          ? "analytische cookies geweigerd"
          : "nog geen keuze gemaakt";
  }

  renderStatus();
  changeButton?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-cookie-preferences"));
  });
  window.addEventListener("cookie-consent-changed", renderStatus);
</script>
