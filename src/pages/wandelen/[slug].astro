---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Button from "../../components/Button.astro";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";
import { getWandelingen } from "../../sanity/lib/queries";

export async function getStaticPaths() {
  const wandelingen = await getWandelingen();
  return wandelingen
    .filter((w) => (w.etappes?.length ?? 0) > 0 && !!w.gpxBestand)
    .map((w) => ({ params: { slug: w.slug.current }, props: { wandeling: w } }));
}

const { wandeling } = Astro.props;

const bestandsgrootteKB = wandeling.gpxBestand
  ? Math.round(wandeling.gpxBestand.asset.size / 1024)
  : null;

// Sanity's CDN is cross-origin, waar de HTML `download`-attribuut geen
// effect heeft — de `?dl=` parameter forceert een download via de
// Content-Disposition header die Sanity zelf meestuurt.
const gpxDownloadUrl = wandeling.gpxBestand
  ? `${wandeling.gpxBestand.asset.url}?dl=${encodeURIComponent(wandeling.gpxBestand.asset.originalFilename)}`
  : undefined;
---

<Layout
  title={`${wandeling.titel} — Saveur & Savoir`}
  description={wandeling.excerpt}
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container class="max-w-2xl">
      <a href="/wandelen" class="text-sm text-blue-500 hover:text-terracotta-500">← Alle routes</a>
      <Eyebrow class="mt-6">Route · {wandeling.streek}</Eyebrow>
      <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
        {wandeling.titel}
      </h1>
      <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">
        {wandeling.excerpt}
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Afstand</dt>
          <dd>{wandeling.afstand}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Duur</dt>
          <dd>{wandeling.duur}</dd>
        </div>
        {
          wandeling.hoogteverschil && (
            <div class="flex items-center gap-2">
              <dt class="font-medium text-ink-900">Hoogteverschil</dt>
              <dd>{wandeling.hoogteverschil}</dd>
            </div>
          )
        }
        {
          wandeling.niveau && (
            <div class="flex items-center gap-2">
              <dt class="font-medium text-ink-900">Niveau</dt>
              <dd>{wandeling.niveau}</dd>
            </div>
          )
        }
      </dl>
    </Container>
  </Section>

  <Section spacing="sm" tone="cream">
    <Container wide>
      <SanityImage image={wandeling.afbeelding} ratio="16/9" tone="olive" class="rounded-sm" />
    </Container>
  </Section>

  {
    wandeling.intro && (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <PortableText value={wandeling.intro} />
        </Container>
      </Section>
    )
  }

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <h2 class="font-serif text-xl text-ink-900">De etappes</h2>
        <ol class="mt-6 space-y-2 text-sm text-ink-700">
          {
            wandeling.etappes?.map((etappe, i) => (
              <li class="flex gap-4 border-t border-blue-200 py-2">
                <span class="w-6 shrink-0 font-serif text-terracotta-500">{i + 1}</span>
                <span>{etappe}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="border border-blue-200 bg-cream-50 p-8">
        <h2 class="font-serif text-xl text-ink-900">Download de route</h2>
        <p class="mt-3 text-sm text-ink-500">
          Het volledige gpx-bestand voor deze route, te openen in elke
          wandel-app of gps-toestel.
        </p>
        <dl class="mt-6 space-y-2 text-sm text-ink-700">
          <div class="flex justify-between border-t border-blue-200 pt-2">
            <dt>Bestandstype</dt>
            <dd>GPX</dd>
          </div>
          {
            bestandsgrootteKB && (
              <div class="flex justify-between border-t border-blue-200 pt-2">
                <dt>Bestandsgrootte</dt>
                <dd>±{bestandsgrootteKB} KB</dd>
              </div>
            )
          }
        </dl>
        <div class="mt-6">
          <Button href={gpxDownloadUrl as string} variant="primary" download>
            Download GPX
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
