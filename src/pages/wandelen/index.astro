---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import OverviewCard from "../../components/OverviewCard.astro";
import { getWandelingen } from "../../sanity/lib/queries";

const wandelingen = await getWandelingen();
const tonen = ["olive", "blue", "terracotta", "ochre"] as const;
---

<Layout
  title="Wandelen in Frankrijk — Saveur & Savoir"
  description="Routes door Franse landschappen, met kaarten en gpx-bestanden om zelf te stappen."
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container wide>
      <Eyebrow>Wandelen in Frankrijk</Eyebrow>
      <h1 class="mt-6 max-w-2xl font-serif text-4xl text-ink-900 sm:text-5xl">
        Paden die je op je eigen tempo mag lopen.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-500">
        Routes die ik zelf gestapt heb, met de praktische details erbij —
        inclusief het gpx-bestand om ze na te wandelen.
      </p>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          wandelingen.map((w, i) => {
            const isGepubliceerd = (w.etappes?.length ?? 0) > 0 && !!w.gpxBestand;
            return (
              <OverviewCard
                href={isGepubliceerd ? `/wandelen/${w.slug.current}` : null}
                eyebrow="Route"
                title={w.titel}
                excerpt={w.excerpt}
                meta={`${w.afstand} · ${w.duur}`}
                image={w.afbeelding}
                tone={tonen[i % tonen.length]}
              />
            );
          })
        }
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
