---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import OverviewCard from "../../components/OverviewCard.astro";
import PortableText from "../../components/PortableText.astro";
import { getPagina, getRecepten } from "../../sanity/lib/queries";

const [pagina, recepten] = await Promise.all([getPagina("paginaRecepten"), getRecepten()]);
const tonen = ["olive", "ochre", "terracotta", "blue"] as const;
---

<Layout
  title={`${pagina?.paginatitel} — Saveur & Savoir`}
  description="Gerechten uit Franse keukens, uitgeprobeerd en doorverteld — met de verhalen erbij."
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container wide>
      <Eyebrow>{pagina?.paginatitel}</Eyebrow>
      <h1 class="mt-6 max-w-2xl font-serif text-4xl text-ink-900 sm:text-5xl">
        {pagina?.kop}
      </h1>
      <PortableText value={pagina?.introtekst} class="mt-6 max-w-xl text-lg text-ink-500" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          recepten.map((r, i) => {
            const isGepubliceerd = (r.bereidingsstappen?.length ?? 0) > 0;
            return (
              <OverviewCard
                href={isGepubliceerd ? `/recepten/${r.slug.current}` : null}
                eyebrow="Recept"
                title={r.titel}
                excerpt={r.excerpt}
                meta={`${r.bereidingstijd} · ${r.niveau}`}
                image={r.afbeelding}
                tone={tonen[i % tonen.length]}
              />
            );
          })
        }
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
