---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";

const ingredienten = [
  "2 courgettes, in blokjes",
  "3 aardappelen, in blokjes",
  "2 wortels, in plakjes",
  "200 g witte bonen, uitgelekt",
  "200 g sperziebonen, in stukken",
  "2 tomaten, ontveld en in blokjes",
  "100 g kleine pastasoort (bv. coquillettes)",
  "2 liter groentebouillon",
  "Zout en versgemalen peper",
];

const pistou = [
  "3 tenen knoflook",
  "1 grote bos verse basilicum",
  "100 ml olijfolie",
  "60 g Parmezaanse kaas, geraspt",
];

const stappen = [
  {
    titel: "Bouillon aan de kook brengen",
    tekst: "Breng de groentebouillon aan de kook in een grote soeppan en breng op smaak met zout en peper.",
  },
  {
    titel: "Aardappelen en wortels",
    tekst: "Voeg de aardappelen en wortels toe en laat 10 minuten zachtjes koken.",
  },
  {
    titel: "De rest van de groenten",
    tekst: "Voeg de courgette, sperziebonen en witte bonen toe. Laat nog 10 minuten sudderen.",
  },
  {
    titel: "Pasta en tomaat",
    tekst: "Roer de pasta en tomatenblokjes erdoor en kook nog 8 tot 10 minuten, tot de pasta beetgaar is.",
  },
  {
    titel: "De pistou maken",
    tekst:
      "Stamp de knoflook, basilicum, olijfolie en Parmezaanse kaas in een vijzel (of blender) tot een grove, geurige pasta.",
  },
  {
    titel: "Serveren",
    tekst:
      "Verdeel de soep over de kommen en roer bij elke kom vlak voor het serveren een flinke lepel pistou erdoor. Nooit meekoken — dan verliest de basilicum zijn frisheid.",
  },
];
---

<Layout
  title="Soupe au pistou — Saveur & Savoir"
  description="De Provençaalse groentesoep die pas leeft door de basilicumpasta die je er vers doorheen roert."
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container class="max-w-2xl">
      <a href="/recepten" class="text-sm text-blue-500 hover:text-terracotta-500">← Alle recepten</a>
      <Eyebrow class="mt-6">Recept · Provence</Eyebrow>
      <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
        Soupe au pistou
      </h1>
      <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">
        Een zomerse groentesoep uit de Provence die pas tot leven komt op het
        moment dat je er, vlak voor het opdienen, een lepel geurige
        basilicumpasta doorheen roert.
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Bereidingstijd</dt>
          <dd>45 min</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Voor</dt>
          <dd>6 personen</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Niveau</dt>
          <dd>Gemakkelijk</dd>
        </div>
      </dl>
    </Container>
  </Section>

  <Section spacing="sm" tone="cream">
    <Container wide>
      <PlaceholderImage ratio="16/9" tone="olive" class="rounded-sm" label="Beeld volgt" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="max-w-2xl">
      <p class="text-base leading-relaxed text-ink-700">
        Soupe au pistou is het bewijs dat een simpele groentesoep iets
        bijzonders wordt door één goed idee: de kruidenpasta apart houden tot
        het laatste moment. Wat in de Italiaanse keuken pesto heet, heet hier
        pistou — zonder pijnboompitten, met net iets meer knoflook. De soep
        zelf is flexibel: gebruik wat de groentela te bieden heeft, zolang de
        pistou er maar vers doorheen gaat.
      </p>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <h2 class="font-serif text-xl text-ink-900">Voor de soep</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          {ingredienten.map((i) => <li class="border-t border-blue-200 pt-2">{i}</li>)}
        </ul>

        <h2 class="mt-10 font-serif text-xl text-ink-900">Voor de pistou</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          {pistou.map((i) => <li class="border-t border-blue-200 pt-2">{i}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-serif text-xl text-ink-900">Bereiding</h2>
        <ol class="mt-6 space-y-8">
          {
            stappen.map((stap, i) => (
              <li class="flex gap-6">
                <span class="font-serif text-lg text-terracotta-500">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="font-serif text-lg text-ink-900">{stap.titel}</h3>
                  <p class="mt-2 text-base leading-relaxed text-ink-700">{stap.tekst}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="mt-10 border-l-2 border-ochre-400 py-1 pl-6 font-serif text-lg text-ink-900 italic">
          Maak gerust een dubbele hoeveelheid pistou — met een laagje olijfolie
          erop bewaart het prima in de koelkast, heerlijk door pasta of op
          geroosterd brood.
        </p>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
