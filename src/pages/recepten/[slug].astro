---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";
import Button from "../../components/Button.astro";
import { getRecepten } from "../../sanity/lib/queries";
import { getShopifyProducten } from "../../shopify/client";
import { urlFor } from "../../sanity/lib/image";

export async function getStaticPaths() {
  const recepten = await getRecepten();
  // Sinds de ingrediënten/bereiding niet meer op de site staan (vervangen
  // door de Receptkaart-CTA), is de introtekst het enige overgebleven
  // inhoudsveld dat bepaalt of een recept "af" is voor publicatie.
  return recepten
    .filter((r) => (r.intro?.length ?? 0) > 0)
    .map((r) => ({ params: { slug: r.slug.current }, props: { recept: r } }));
}

const { recept } = Astro.props;

// De receptkaart-link wijst naar een Shopify-handle (Shopify is de enige
// bron voor productdata). Toon de CTA alleen als die handle ook echt naar
// een bestaand product wijst — nooit een dode link. Deze pagina blijft
// statisch (Sanity-content), dus deze check gebeurt op build-time; een
// Shopify-productwijziging triggert een rebuild via de webhook (zie
// src/pages/api/shopify-webhook.ts), die dit dan meteen herverifieert.
const shopifyProducten = await getShopifyProducten();
const geldigeHandles = new Set(shopifyProducten.map((p) => p.handle));
const toonReceptkaart = Boolean(recept.receptkaartHandle && geldigeHandles.has(recept.receptkaartHandle));

const socialImage = recept.afbeelding
  ? urlFor(recept.afbeelding).width(1200).height(630).fit("crop").url()
  : undefined;
---

<Layout title={`${recept.titel} — Saveur & Savoir`} description={recept.excerpt} image={socialImage}>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container class="max-w-2xl">
      <a href="/recepten" class="text-sm text-blue-500 hover:text-terracotta-500">← Alle recepten</a>
      <Eyebrow class="mt-6">Recept · {recept.streek}</Eyebrow>
      <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
        {recept.titel}
      </h1>
      <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">
        {recept.excerpt}
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Bereidingstijd</dt>
          <dd>{recept.bereidingstijd}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Voor</dt>
          <dd>{recept.aantalPersonen}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Niveau</dt>
          <dd>{recept.niveau}</dd>
        </div>
      </dl>
    </Container>
  </Section>

  <Section spacing="sm" tone="cream">
    <Container wide>
      <SanityImage image={recept.afbeelding} ratio="16/9" tone="olive" class="rounded-sm" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="max-w-2xl">
      <PortableText value={recept.intro} class="text-base text-ink-700" />
      {
        recept.tip && (
          <p class="mt-10 border-l-2 border-ochre-400 py-1 pl-6 font-serif text-lg text-ink-900 italic">
            {recept.tip}
          </p>
        )
      }
    </Container>
  </Section>

  {
    toonReceptkaart && (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <div class="border border-blue-200 bg-cream-50 p-8">
            <Eyebrow>Receptkaart</Eyebrow>
            <p class="mt-3 text-sm text-ink-500">
              Liever dit recept als kant-en-klaar pakket in huis? Bekijk het als product in de webshop.
            </p>
            <div class="mt-6">
              <Button href={`/webshop/${recept.receptkaartHandle}`} variant="primary">
                {recept.receptkaartKnoptekst || "Bekijk in de webshop"}
              </Button>
            </div>
          </div>
        </Container>
      </Section>
    )
  }

  <Footer />
</Layout>
