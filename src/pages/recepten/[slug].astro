---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";
import Button from "../../components/Button.astro";
import JsonLd from "../../components/JsonLd.astro";
import OverviewCard from "../../components/OverviewCard.astro";
import { getRecepten } from "../../sanity/lib/queries";
import { getShopifyProducten } from "../../shopify/client";
import { urlFor } from "../../sanity/lib/image";

export async function getStaticPaths() {
  const recepten = await getRecepten();
  // Sinds de ingrediënten/bereiding niet meer op de site staan (vervangen
  // door de Receptenkaart-CTA), is de introtekst het enige overgebleven
  // inhoudsveld dat bepaalt of een recept "af" is voor publicatie.
  return recepten
    .filter((r) => (r.intro?.length ?? 0) > 0)
    .map((r) => ({ params: { slug: r.slug.current }, props: { recept: r } }));
}

const { recept } = Astro.props;

// Alle productverwijzingen (receptenkaart-CTA + "producten bij dit
// recept") wijzen naar Shopify-handles (Shopify is de enige bron voor
// productdata, geen tweede handmatige productlijst in Sanity). Toon
// alleen wat ook echt naar een bestaand product wijst — nooit een dode
// link. Deze pagina blijft statisch (Sanity-content), dus deze check
// gebeurt op build-time; een Shopify-productwijziging triggert een
// rebuild via de webhook (zie src/pages/api/shopify-webhook.ts), die dit
// dan meteen herverifieert.
const shopifyProducten = await getShopifyProducten();
const productenPerHandle = new Map(shopifyProducten.map((p) => [p.handle, p]));

const receptenkaartProduct = recept.receptenkaartHandle
  ? productenPerHandle.get(recept.receptenkaartHandle)
  : undefined;
const toonReceptenkaart = Boolean(receptenkaartProduct);

// "Producten bij dit recept": alleen items met een geldige handle, met
// het bijhorende live Shopify-product erbij voor beeld/prijs — de eigen
// tekst per item komt uit Sanity, de rest (naam, beeld, prijs) blijft
// altijd Shopify.
const gerelateerdeProducten = (recept.gerelateerdeProducten ?? [])
  .map((item) => {
    const product = productenPerHandle.get(item.productHandle);
    return product ? { ...item, product } : null;
  })
  .filter((item) => item !== null);

const socialImage = recept.afbeelding
  ? urlFor(recept.afbeelding).width(1200).height(630).fit("crop").url()
  : undefined;

const pageTitle = recept.seoTitel || `${recept.titel} — Saveur & Savoir`;
const pageDescription = recept.seoOmschrijving || recept.excerpt;

const publicatiedatumWeergave = new Intl.DateTimeFormat("nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(recept.publicatiedatum));

// Article-schema (JSON-LD) voor Google en AI-crawlers. Bewust GEEN
// Recipe-schema: er staan geen ingrediënten/bereidingsstappen op deze
// pagina (die zijn nu een los te kopen receptenkaart in de webshop), en
// Recipe-structured-data die naar niet-zichtbare content verwijst is in
// strijd met Google's richtlijnen. Elk veld hieronder komt overeen met
// tekst die ook echt zichtbaar op de pagina staat.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString();

// Google verwacht volledig ISO 8601 (met tijd + tijdzone) voor
// datePublished, net als dateModified (die al een volledige datetime is
// via Sanity's _updatedAt). Het Sanity-veld publicatiedatum blijft
// bewust een simpele datum (geen tijd) — makkelijker voor de eigenaar om
// in te vullen — dus hier wordt een vast tijdstip toegevoegd, in UTC
// ("Z") om het hele zomer-/wintertijd-verhaal (+01:00 vs +02:00) te
// vermijden. Consequent toegepast: dit is de enige plek waar dit gebeurt.
const datePublished = `${recept.publicatiedatum}T09:00:00Z`;

// mentions: de producten die dit receptverhaal echt noemt — de
// receptenkaart-CTA en/of de "producten bij dit recept"-lijst hieronder.
// Alleen toevoegen als er ook echt een gekoppeld product is; nooit een
// product noemen dat niet op de pagina zelf voorkomt.
const mentionedProducten = [
  ...(receptenkaartProduct ? [receptenkaartProduct] : []),
  ...gerelateerdeProducten.map((item) => item.product),
].filter((product, index, lijst) => lijst.findIndex((p) => p.handle === product.handle) === index);

const mentions = mentionedProducten.length
  ? mentionedProducten.map((product) => ({
      "@type": "Product",
      name: product.titel,
      url: siteUrl ? new URL(`/webshop/${product.handle}`, siteUrl).toString() : undefined,
      image: product.afbeelding?.url,
    }))
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: recept.titel,
  description: pageDescription,
  image: socialImage ? [socialImage] : undefined,
  datePublished,
  dateModified: recept._updatedAt,
  author: { "@type": "Organization", name: "Saveur & Savoir", url: siteUrl },
  publisher: { "@type": "Organization", name: "Saveur & Savoir" },
  articleSection: recept.streek || undefined,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  mentions,
};
---

<Layout title={pageTitle} description={pageDescription} image={socialImage}>
  <JsonLd data={articleSchema} />
  <Header />

  <Section spacing="sm" tone="cream">
    <Container class="max-w-2xl">
      <a href="/recepten" class="text-sm text-blue-500 hover:text-terracotta-500">← Alle recepten</a>
      <Eyebrow class="mt-6">Recept · {recept.streek}</Eyebrow>
      <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
        {recept.titel}
      </h1>
      <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">
        {recept.excerpt}
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Bereidingstijd</dt>
          <dd>{recept.bereidingstijd}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Voor</dt>
          <dd>{recept.aantalPersonen}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Niveau</dt>
          <dd>{recept.niveau}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Gepubliceerd</dt>
          <dd>{publicatiedatumWeergave}</dd>
        </div>
      </dl>
    </Container>
  </Section>

  <Section spacing="sm" tone="cream">
    <Container wide>
      <SanityImage image={recept.afbeelding} ratio="16/9" tone="olive" class="rounded-sm" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="max-w-2xl">
      <PortableText value={recept.intro} class="text-base text-ink-700" />
      {
        recept.tip && (
          <p class="mt-10 border-l-2 border-ochre-400 py-1 pl-6 font-serif text-lg text-ink-900 italic">
            {recept.tip}
          </p>
        )
      }
    </Container>
  </Section>

  {
    toonReceptenkaart && (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <div class="border border-blue-200 bg-cream-50 p-8">
            <Eyebrow>Receptenkaart</Eyebrow>
            <p class="mt-3 text-sm text-ink-500">
              {recept.receptenkaartTekst ||
                "Liever dit recept als kant-en-klaar pakket in huis? Bekijk het als product in de webshop."}
            </p>
            <div class="mt-6">
              <Button href={`/webshop/${recept.receptenkaartHandle}`} variant="primary">
                {recept.receptenkaartKnoptekst || "Bekijk in de webshop"}
              </Button>
            </div>
          </div>
        </Container>
      </Section>
    )
  }

  {
    gerelateerdeProducten.length > 0 && (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <Eyebrow>Producten bij dit recept</Eyebrow>
          <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
            {gerelateerdeProducten.map(({ product, tekst }) => (
              <OverviewCard
                href={`/webshop/${product.handle}`}
                eyebrow={product.categorie ?? "Product"}
                title={product.titel}
                excerpt={tekst}
                prijs={product.prijs}
                meta={product.beschikbaar ? undefined : "Tijdelijk uitverkocht"}
                imageUrl={product.afbeelding?.url}
                imageAlt={product.afbeelding?.alt ?? product.titel}
              />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <Footer />
</Layout>
