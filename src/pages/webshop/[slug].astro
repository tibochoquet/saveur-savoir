---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Button from "../../components/Button.astro";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";
import { getProducten } from "../../sanity/lib/queries";

export async function getStaticPaths() {
  const producten = await getProducten();
  return producten
    .filter((product) => (product.verhaal?.length ?? 0) > 0)
    .map((product) => ({ params: { slug: product.slug.current }, props: { product } }));
}

const { product } = Astro.props;
---

<Layout
  title={`${product.naam} — Saveur & Savoir`}
  description={product.excerpt}
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container class="max-w-2xl">
      <a href="/webshop" class="text-sm text-blue-500 hover:text-terracotta-500">← Alle producten</a>
      <Eyebrow class="mt-6">Product · {product.categorie}</Eyebrow>
      <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
        {product.naam}
      </h1>
      <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">
        {product.dek}
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Prijs</dt>
          <dd>{product.prijs}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Herkomst</dt>
          <dd>{product.herkomst}</dd>
        </div>
        <div class="flex items-center gap-2">
          <dt class="font-medium text-ink-900">Soort</dt>
          <dd>{product.soort === "digitaal" ? "Digitaal bestand" : "Fysiek product"}</dd>
        </div>
      </dl>
    </Container>
  </Section>

  <Section spacing="sm" tone="cream">
    <Container wide>
      <SanityImage image={product.afbeelding} ratio="16/9" tone="ochre" class="rounded-sm" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="max-w-2xl">
      <Eyebrow>Het verhaal</Eyebrow>
      <div class="mt-8">
        <PortableText value={product.verhaal} />
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="max-w-2xl">
      <div class="border border-blue-200 bg-cream-50 p-8">
        <h2 class="font-serif text-xl text-ink-900">{product.naam}</h2>
        <p class="mt-2 font-serif text-2xl text-terracotta-600">{product.prijs}</p>
        <p class="mt-3 text-sm text-ink-500">
          {
            product.soort === "digitaal"
              ? "Geen automatische afrekening — je vraagt aan, ik bevestig persoonlijk en je ontvangt het bestand na afspraak. Geen verzendkosten."
              : "Geen webshop, geen automatische afrekening — je vraagt aan, ik bevestig persoonlijk beschikbaarheid en verzendkosten."
          }
        </p>
        <div class="mt-6">
          <Button href={`/contact?onderwerp=${encodeURIComponent(product.naam)}`} variant="primary">
            Vraag dit product aan
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
