---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { getShopifyProductByHandle } from "../../shopify/client";

// Op-aanvraag gerenderd: prijs en voorraad moeten bij elk bezoek live uit
// Shopify komen (zie astro.config.mjs voor de ISR-cache). Shopify is de
// enige bron voor productdata — geen Sanity-fallback meer.
export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getShopifyProductByHandle(slug) : null;

if (!product) {
  Astro.response.status = 404;
}
---

{
  product ? (
    <Layout
      title={`${product.titel} — Saveur & Savoir`}
      description={product.categorie ?? undefined}
      image={product.afbeelding?.url}
    >
      <Header />

      <Section spacing="sm" tone="cream">
        <Container class="max-w-2xl">
          <a href="/webshop" class="text-sm text-blue-500 hover:text-terracotta-500">
            ← Alle producten
          </a>
          {product.categorie && <Eyebrow class="mt-6">Product · {product.categorie}</Eyebrow>}
          <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">{product.titel}</h1>
        </Container>
      </Section>

      <Section spacing="sm" tone="cream">
        <Container class="max-w-2xl">
          {product.afbeelding ? (
            // object-contain i.p.v. object-cover: Shopify-productfoto's zijn
            // vaak klein en vierkant, niet bijgesneden zoals Sanity-beelden.
            // Cover sneed het product af aan boven-/onderkant. Contain toont
            // altijd de volledige foto; een neutrale achtergrond vult de
            // rest als de verhouding niet exact klopt. Ratio 4/3, dezelfde
            // als in het webshop-overzicht, voor een consistente container.
            <div class="relative w-full overflow-hidden rounded-sm bg-cream-50" style="aspect-ratio: 4/3;">
              <img
                src={product.afbeelding.url}
                alt={product.afbeelding.alt ?? product.titel}
                width="1200"
                height="900"
                class="h-full w-full object-contain"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="flex aspect-[4/3] items-center justify-center bg-ochre-100 text-sm text-ochre-700">
              Beeld volgt
            </div>
          )}
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <Eyebrow>Over dit product</Eyebrow>
          <div class="mt-8 text-base leading-relaxed text-ink-700" set:html={product.beschrijvingHtml} />
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <div class="border border-blue-200 bg-cream-50 p-8" data-product-purchase data-variant-id={product.variantId ?? ""}>
            <h2 class="font-serif text-xl text-ink-900">{product.titel}</h2>
            <p class="mt-2 font-serif text-2xl text-terracotta-600">{product.prijs}</p>

            {product.beschikbaar && product.variantId ? (
              <>
                <div class="mt-6 flex items-center gap-4">
                  <div class="flex items-center border border-blue-300">
                    <button
                      type="button"
                      data-qty-decrement
                      aria-label="Minder"
                      class="px-3 py-2 text-lg text-ink-700 hover:text-terracotta-500"
                    >
                      −
                    </button>
                    <span data-qty-value class="min-w-[2ch] text-center text-sm text-ink-900">1</span>
                    <button
                      type="button"
                      data-qty-increment
                      aria-label="Meer"
                      class="px-3 py-2 text-lg text-ink-700 hover:text-terracotta-500"
                    >
                      +
                    </button>
                  </div>
                  <button
                    type="button"
                    data-add-to-cart
                    class="inline-flex items-center gap-2 bg-terracotta-500 px-6 py-3 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:bg-terracotta-600"
                  >
                    In winkelwagen
                  </button>
                </div>
                <p data-add-to-cart-status class="mt-3 hidden text-sm text-blue-600" role="status"></p>
                <p class="mt-4 text-xs text-ink-500">
                  Liever direct afrekenen?{" "}
                  <a href={product.productUrl} target="_blank" rel="noopener" class="text-blue-500 underline hover:text-terracotta-500">
                    Ga naar Shopify-checkout
                  </a>
                  .
                </p>
              </>
            ) : (
              // Uitverkocht (of geen variant beschikbaar): geen aantal-kiezer,
              // geen "In winkelwagen"-knop — kan dus niet toegevoegd worden.
              <p class="mt-3 text-sm font-medium text-terracotta-600">Tijdelijk uitverkocht</p>
            )}
          </div>
        </Container>
      </Section>

      <Footer />
    </Layout>
  ) : (
    <Layout title="Product niet gevonden — Saveur & Savoir">
      <Header />
      <Section spacing="lg" tone="cream">
        <Container class="max-w-2xl">
          <Eyebrow>Product niet gevonden</Eyebrow>
          <h1 class="mt-6 font-serif text-4xl text-ink-900 sm:text-5xl">Dit product bestaat niet (meer).</h1>
          <p class="mt-6 text-base text-ink-500">
            Mogelijk is het niet meer beschikbaar. Bekijk de{" "}
            <a href="/webshop" class="text-blue-500 underline hover:text-terracotta-500">
              volledige webshop
            </a>
            .
          </p>
        </Container>
      </Section>
      <Footer />
    </Layout>
  )
}

<script>
  import { addToCart } from "../../shopify/cart";

  const wrapper = document.querySelector<HTMLElement>("[data-product-purchase]");
  const variantId = wrapper?.dataset.variantId;
  if (wrapper && variantId) {
    const qtyValue = wrapper.querySelector<HTMLElement>("[data-qty-value]");
    const decrementBtn = wrapper.querySelector<HTMLButtonElement>("[data-qty-decrement]");
    const incrementBtn = wrapper.querySelector<HTMLButtonElement>("[data-qty-increment]");
    const addButton = wrapper.querySelector<HTMLButtonElement>("[data-add-to-cart]");
    const status = wrapper.querySelector<HTMLElement>("[data-add-to-cart-status]");

    let qty = 1;
    const renderQty = () => {
      if (qtyValue) qtyValue.textContent = String(qty);
    };

    decrementBtn?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      renderQty();
    });
    incrementBtn?.addEventListener("click", () => {
      qty += 1;
      renderQty();
    });

    addButton?.addEventListener("click", async () => {
      if (!addButton) return;
      addButton.disabled = true;
      addButton.textContent = "Bezig...";
      const cart = await addToCart(variantId, qty);
      addButton.disabled = false;
      addButton.textContent = "In winkelwagen";

      if (status) {
        status.classList.remove("hidden");
        status.textContent = cart
          ? "Toegevoegd aan je winkelwagen."
          : "Er ging iets mis — probeer het nog eens.";
      }
    });
  }
</script>
