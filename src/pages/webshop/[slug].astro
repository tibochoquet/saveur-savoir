---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Button from "../../components/Button.astro";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";
import { getProducten } from "../../sanity/lib/queries";
import { getShopifyProducten } from "../../shopify/client";
import type { Product } from "../../sanity/lib/types";
import type { ShopifyProduct } from "../../shopify/types";

type Props =
  | { bron: "shopify"; shopifyProduct: ShopifyProduct }
  | { bron: "sanity"; sanityProduct: Product };

export async function getStaticPaths() {
  // Shopify levert de huidige webshop-catalogus. De oude Sanity-producten
  // blijven hier ook bereikbaar (zelfde routepatroon, /webshop/:slug) zodat
  // bestaande interne links — bv. het "Deze wandeling downloaden"-blok op
  // het GR70-blogartikel — niet stukgaan. Ze staan niet meer in de
  // /webshop-grid zelf, alleen nog op hun eigen URL.
  const [shopifyProducten, sanityProducten] = await Promise.all([getShopifyProducten(), getProducten()]);

  const shopifyPaths = shopifyProducten.map((product) => ({
    params: { slug: product.handle },
    props: { bron: "shopify" as const, shopifyProduct: product },
  }));

  const sanityPaths = sanityProducten
    .filter((product) => (product.verhaal?.length ?? 0) > 0)
    .map((product) => ({
      params: { slug: product.slug.current },
      props: { bron: "sanity" as const, sanityProduct: product },
    }));

  return [...shopifyPaths, ...sanityPaths];
}

const props = Astro.props as Props;
const isShopify = props.bron === "shopify";
const shopifyProduct = props.bron === "shopify" ? props.shopifyProduct : null;
const sanityProduct = props.bron === "sanity" ? props.sanityProduct : null;
---

{
  isShopify && shopifyProduct && (
    <Layout title={`${shopifyProduct.titel} — Saveur & Savoir`} description={shopifyProduct.categorie ?? undefined}>
      <Header />

      <Section spacing="sm" tone="cream">
        <Container class="max-w-2xl">
          <a href="/webshop" class="text-sm text-blue-500 hover:text-terracotta-500">
            ← Alle producten
          </a>
          {shopifyProduct.categorie && <Eyebrow class="mt-6">Product · {shopifyProduct.categorie}</Eyebrow>}
          <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">{shopifyProduct.titel}</h1>
        </Container>
      </Section>

      <Section spacing="sm" tone="cream">
        <Container class="max-w-2xl">
          {shopifyProduct.afbeelding ? (
            // object-contain i.p.v. object-cover: Shopify-productfoto's zijn
            // vaak klein en vierkant, niet bijgesneden zoals Sanity-beelden.
            // Cover sneed het product af aan boven-/onderkant. Contain toont
            // altijd de volledige foto; een neutrale achtergrond vult de
            // rest als de verhouding niet exact klopt. Ratio 4/3, dezelfde
            // als in het webshop-overzicht, voor een consistente container.
            <div class="relative w-full overflow-hidden rounded-sm bg-cream-50" style="aspect-ratio: 4/3;">
              <img
                src={shopifyProduct.afbeelding.url}
                alt={shopifyProduct.afbeelding.alt ?? shopifyProduct.titel}
                width="1200"
                height="900"
                class="h-full w-full object-contain"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="flex aspect-[4/3] items-center justify-center bg-ochre-100 text-sm text-ochre-700">
              Beeld volgt
            </div>
          )}
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <Eyebrow>Over dit product</Eyebrow>
          <div class="mt-8 text-base leading-relaxed text-ink-700" set:html={shopifyProduct.beschrijvingHtml} />
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <div class="border border-blue-200 bg-cream-50 p-8" data-product-purchase data-variant-id={shopifyProduct.variantId ?? ""}>
            <h2 class="font-serif text-xl text-ink-900">{shopifyProduct.titel}</h2>
            <p class="mt-2 font-serif text-2xl text-terracotta-600">{shopifyProduct.prijs}</p>

            {shopifyProduct.beschikbaar && shopifyProduct.variantId ? (
              <>
                <div class="mt-6 flex items-center gap-4">
                  <div class="flex items-center border border-blue-300">
                    <button
                      type="button"
                      data-qty-decrement
                      aria-label="Minder"
                      class="px-3 py-2 text-lg text-ink-700 hover:text-terracotta-500"
                    >
                      −
                    </button>
                    <span data-qty-value class="min-w-[2ch] text-center text-sm text-ink-900">1</span>
                    <button
                      type="button"
                      data-qty-increment
                      aria-label="Meer"
                      class="px-3 py-2 text-lg text-ink-700 hover:text-terracotta-500"
                    >
                      +
                    </button>
                  </div>
                  <button
                    type="button"
                    data-add-to-cart
                    class="inline-flex items-center gap-2 bg-terracotta-500 px-6 py-3 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:bg-terracotta-600"
                  >
                    In winkelwagen
                  </button>
                </div>
                <p data-add-to-cart-status class="mt-3 hidden text-sm text-blue-600" role="status"></p>
                <p class="mt-4 text-xs text-ink-500">
                  Liever direct afrekenen?{" "}
                  <a href={shopifyProduct.productUrl} target="_blank" rel="noopener" class="text-blue-500 underline hover:text-terracotta-500">
                    Ga naar Shopify-checkout
                  </a>
                  .
                </p>
              </>
            ) : (
              <p class="mt-3 text-sm text-ink-500">Dit product is tijdelijk uitverkocht.</p>
            )}
          </div>
        </Container>
      </Section>

      <Footer />
    </Layout>
  )
}

<script>
  import { addToCart } from "../../shopify/cart";

  const wrapper = document.querySelector<HTMLElement>("[data-product-purchase]");
  const variantId = wrapper?.dataset.variantId;
  if (wrapper && variantId) {
    const qtyValue = wrapper.querySelector<HTMLElement>("[data-qty-value]");
    const decrementBtn = wrapper.querySelector<HTMLButtonElement>("[data-qty-decrement]");
    const incrementBtn = wrapper.querySelector<HTMLButtonElement>("[data-qty-increment]");
    const addButton = wrapper.querySelector<HTMLButtonElement>("[data-add-to-cart]");
    const status = wrapper.querySelector<HTMLElement>("[data-add-to-cart-status]");

    let qty = 1;
    const renderQty = () => {
      if (qtyValue) qtyValue.textContent = String(qty);
    };

    decrementBtn?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      renderQty();
    });
    incrementBtn?.addEventListener("click", () => {
      qty += 1;
      renderQty();
    });

    addButton?.addEventListener("click", async () => {
      if (!addButton) return;
      addButton.disabled = true;
      addButton.textContent = "Bezig...";
      const cart = await addToCart(variantId, qty);
      addButton.disabled = false;
      addButton.textContent = "In winkelwagen";

      if (status) {
        status.classList.remove("hidden");
        status.textContent = cart
          ? "Toegevoegd aan je winkelwagen."
          : "Er ging iets mis — probeer het nog eens.";
      }
    });
  }
</script>

{
  !isShopify && sanityProduct && (
    <Layout title={`${sanityProduct.naam} — Saveur & Savoir`} description={sanityProduct.excerpt}>
      <Header />

      <Section spacing="sm" tone="cream">
        <Container class="max-w-2xl">
          <a href="/webshop" class="text-sm text-blue-500 hover:text-terracotta-500">
            ← Alle producten
          </a>
          <Eyebrow class="mt-6">Product · {sanityProduct.categorie.titel}</Eyebrow>
          <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">{sanityProduct.naam}</h1>
          <p class="mt-6 font-serif text-xl leading-relaxed text-ink-700 italic">{sanityProduct.dek}</p>
          <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
            <div class="flex items-center gap-2">
              <dt class="font-medium text-ink-900">Prijs</dt>
              <dd>{sanityProduct.prijs}</dd>
            </div>
            <div class="flex items-center gap-2">
              <dt class="font-medium text-ink-900">Herkomst</dt>
              <dd>{sanityProduct.herkomst}</dd>
            </div>
            <div class="flex items-center gap-2">
              <dt class="font-medium text-ink-900">Soort</dt>
              <dd>{sanityProduct.soort === "digitaal" ? "Digitaal bestand" : "Fysiek product"}</dd>
            </div>
          </dl>
        </Container>
      </Section>

      <Section spacing="sm" tone="cream">
        <Container wide>
          <SanityImage image={sanityProduct.afbeelding} ratio="16/9" tone="ochre" class="rounded-sm" />
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <Eyebrow>Het verhaal</Eyebrow>
          <div class="mt-8">
            <PortableText value={sanityProduct.verhaal} class="text-base text-ink-700" />
          </div>
        </Container>
      </Section>

      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-2xl">
          <div class="border border-blue-200 bg-cream-50 p-8">
            <h2 class="font-serif text-xl text-ink-900">{sanityProduct.naam}</h2>
            <p class="mt-2 font-serif text-2xl text-terracotta-600">{sanityProduct.prijs}</p>
            <p class="mt-3 text-sm text-ink-500">
              {sanityProduct.soort === "digitaal"
                ? "Geen automatische afrekening — je vraagt aan, ik bevestig persoonlijk en je ontvangt het bestand na afspraak. Geen verzendkosten."
                : "Geen webshop, geen automatische afrekening — je vraagt aan, ik bevestig persoonlijk beschikbaarheid en verzendkosten."}
            </p>
            <div class="mt-6">
              <Button href={`/contact?onderwerp=${encodeURIComponent(sanityProduct.naam)}`} variant="primary">
                Vraag dit product aan
              </Button>
            </div>
          </div>
        </Container>
      </Section>

      <Footer />
    </Layout>
  )
}
