---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import OverviewCard from "../../components/OverviewCard.astro";
import PortableText from "../../components/PortableText.astro";
import SectieMetBeeld from "../../components/SectieMetBeeld.astro";
import { getPaginaWebshop, getProductcategorieen } from "../../sanity/lib/queries";
import { getShopifyProducten, isShopifyGeconfigureerd, kortBeschrijving } from "../../shopify/client";

// Productdata komt uitsluitend uit Shopify — recepten/blog/pagina's
// blijven Sanity. Zonder Shopify-credentials (of zonder producten)
// toont de pagina een nette "binnenkort"-melding, geen lege grid.
const tonen = ["ochre", "blue", "terracotta", "olive"] as const;

const [pagina, producten, productcategorieen] = await Promise.all([
  getPaginaWebshop(),
  getShopifyProducten(),
  getProductcategorieen(),
]);

// Het Sanity-productcategorie-document is sinds de Shopify-koppeling geen
// bron van categorieën meer (die komen nu uit Shopify-collecties) — het
// dient alleen nog als naam→tint-opzoektabel voor de zachte achtergrond
// op het categorie-overzicht. Matcht op titel, hoofdletterongevoelig.
const tintPerCategorie = new Map(
  productcategorieen
    .filter((c) => c.kleurTint)
    .map((c) => [c.titel.toLowerCase(), c.kleurTint as string])
);

const categorieen = [
  "Alles",
  ...Array.from(new Set(producten.map((p) => p.categorie).filter((c): c is string => Boolean(c)))),
];
const toonWebshop = isShopifyGeconfigureerd && producten.length > 0;
---

<Layout
  title={pagina?.seoTitel || `${pagina?.paginatitel} — Saveur & Savoir`}
  description={pagina?.seoOmschrijving || "Een kleine etalage van dingen die ik zelf gebruik en aanraad, rechtstreeks uit Frankrijk."}
>
  <Header />

  <Section spacing="sm" tone="cream">
    <Container wide>
      <SectieMetBeeld image={pagina?.introAfbeelding} ratio="4/5">
        <Eyebrow>{pagina?.paginatitel}</Eyebrow>
        <h1 class="mt-6 max-w-2xl font-serif text-4xl text-ink-900 sm:text-5xl">
          {pagina?.kop}
        </h1>
        <PortableText value={pagina?.introtekst} class="mt-6 max-w-xl text-lg text-ink-500" />
      </SectieMetBeeld>
    </Container>
  </Section>

  {
    toonWebshop ? (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container wide>
          <div id="filters" class="flex flex-wrap gap-3">
            {categorieen.map((cat, i) => (
              <button
                type="button"
                data-filter={cat}
                data-tint={tintPerCategorie.get(cat.toLowerCase()) ?? ""}
                aria-pressed={i === 0 ? "true" : "false"}
                class:list={[
                  "border px-4 py-2 text-xs font-medium tracking-wide uppercase transition-colors",
                  i === 0
                    ? "border-terracotta-500 bg-terracotta-500 text-cream-50"
                    : "border-blue-300 text-ink-700 hover:border-terracotta-500 hover:text-terracotta-500",
                ]}
              >
                {cat}
              </button>
            ))}
          </div>

          <div id="webshop-tint-area" class="mt-8 rounded-sm p-6 transition-colors duration-300 sm:p-8">
            <div id="product-grid" class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
              {producten.map((product, i) => (
                <OverviewCard
                  href={`/webshop/${product.handle}`}
                  eyebrow={product.categorie ?? "Product"}
                  title={product.titel}
                  excerpt={kortBeschrijving(product.beschrijvingHtml)}
                  prijs={product.prijs}
                  meta={product.beschikbaar ? undefined : "Tijdelijk uitverkocht"}
                  imageUrl={product.afbeelding?.url}
                  imageAlt={product.afbeelding?.alt ?? product.titel}
                  tone={tonen[i % tonen.length]}
                  dataCategory={product.categorie ?? undefined}
                />
              ))}
            </div>

            <p id="no-results" class="hidden text-sm text-ink-500">
              Nog geen producten in deze categorie — kom snel terug.
            </p>
          </div>
        </Container>
      </Section>
    ) : (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <Container class="max-w-xl text-center">
          <Eyebrow class="justify-center">Webshop</Eyebrow>
          <p class="mt-6 font-serif text-2xl text-ink-900">De webshop komt binnenkort.</p>
          <p class="mt-4 text-base text-ink-500">
            We zijn de etalage nog aan het inrichten — kom snel terug, of{" "}
            <a href="/contact" class="text-terracotta-600 underline decoration-ochre-400 decoration-2 hover:decoration-terracotta-500">
              stuur een bericht
            </a>{" "}
            als je nu al iets zoekt.
          </p>
        </Container>
      </Section>
    )
  }

  <Section spacing="base" tone="blue" class="border-t border-blue-800">
    <Container wide>
      <Eyebrow class="text-ochre-300">Hoe bestellen werkt</Eyebrow>
      <div class="mt-10 divide-y divide-cream-50/20">
        {
          pagina?.bestelStappen.map((stap, i) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8">
              <span class="w-10 shrink-0 font-serif text-sm text-ochre-300">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="w-full shrink-0 font-serif text-lg text-cream-50 sm:w-56">{stap.titel}</h3>
              <PortableText value={stap.tekst} class="text-sm text-blue-100" />
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("#filters button");
  const cards = document.querySelectorAll<HTMLElement>("#product-grid > *");
  const noResults = document.getElementById("no-results");
  const tintArea = document.getElementById("webshop-tint-area");

  // Alle mogelijke tinten uit productcategorie.ts — vooraf opsommen zodat
  // Tailwind ze allemaal genereert (dynamische classList.add zonder dat de
  // klasse letterlijk ergens in de source staat, wordt anders weggeschud).
  const ALLE_TINTEN = ["bg-blue-100", "bg-olive-100", "bg-ochre-100", "bg-terracotta-100", "bg-cream-200", "bg-cream-300"];

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      tintArea?.classList.remove(...ALLE_TINTEN);
      if (button.dataset.tint) {
        tintArea?.classList.add(button.dataset.tint);
      }

      filterButtons.forEach((b) => {
        const active = b === button;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("border-terracotta-500", active);
        b.classList.toggle("bg-terracotta-500", active);
        b.classList.toggle("text-cream-50", active);
        b.classList.toggle("border-blue-300", !active);
        b.classList.toggle("text-ink-700", !active);
        b.classList.toggle("hover:border-terracotta-500", !active);
        b.classList.toggle("hover:text-terracotta-500", !active);
      });

      let visibleCount = 0;
      cards.forEach((card) => {
        const matches = filter === "Alles" || card.dataset.category === filter;
        card.classList.toggle("hidden", !matches);
        if (matches) visibleCount++;
      });

      noResults?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
