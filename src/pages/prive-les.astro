---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SanityImage from "../components/SanityImage.astro";
import PortableText from "../components/PortableText.astro";
import SectieMetBeeld from "../components/SectieMetBeeld.astro";
import { getPaginaPriveLes } from "../sanity/lib/queries";

const pagina = await getPaginaPriveLes();
---

<Layout
  title={pagina?.seoTitel || `${pagina?.heroTitel} — Saveur & Savoir`}
  description={pagina?.seoOmschrijving || "Persoonlijke taallessen Frans en Nederlands, op maat van jouw niveau en tempo."}
>
  <Header />

  <Section spacing="lg" tone="cream">
    <Container wide class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <SanityImage image={pagina?.heroAfbeelding} ratio="4/5" tone="terracotta" class="order-1 rounded-sm" />
      <div class="order-2">
        <Eyebrow>{pagina?.heroEyebrow}</Eyebrow>
        <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
          {pagina?.heroTitel}
        </h1>
        <PortableText value={pagina?.heroIntro} class="mt-6 max-w-md text-lg text-ink-500" />
        <div class="mt-10">
          <Button href="/contact" variant="primary">{pagina?.heroKnoptekst}</Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <SectieMetBeeld image={pagina?.watHetIsAfbeelding} ratio="4/3">
        <Eyebrow class="self-start">{pagina?.watHetIsEyebrow}</Eyebrow>
        <PortableText value={pagina?.watHetIsTekst} class="mt-4 max-w-2xl text-lg text-ink-700" />
      </SectieMetBeeld>
    </Container>
  </Section>

  <Section spacing="base" tone="olive" class="border-t border-olive-800">
    <Container wide>
      <Eyebrow class="text-ochre-200">{pagina?.doelgroepEyebrow}</Eyebrow>
      <div class="mt-10 grid gap-x-16 gap-y-10 sm:grid-cols-2">
        {
          pagina?.doelgroepenItems.map((item) => (
            <div>
              <h3 class="font-serif text-2xl text-cream-50">{item.titel}</h3>
              <PortableText value={item.tekst} class="mt-3 max-w-sm text-sm text-olive-100" />
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <Eyebrow>{pagina?.hoeHetWerktEyebrow}</Eyebrow>
      <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          pagina?.hoeHetWerktStappen.map((stap, i) => (
            <div>
              <span class="font-serif text-sm text-terracotta-500">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 font-serif text-lg text-ink-900">{stap.titel}</h3>
              <PortableText value={stap.tekst} class="mt-3 text-sm text-ink-500" />
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="text-center">
      <Eyebrow class="justify-center">{pagina?.ctaEyebrow}</Eyebrow>
      <h2 class="mx-auto mt-6 max-w-xl font-serif text-3xl text-ink-900 sm:text-4xl">
        {pagina?.ctaTitel}
      </h2>
      <PortableText value={pagina?.ctaTekst} class="mx-auto mt-6 max-w-md text-base text-ink-500" />
      <div class="mt-10">
        <Button href="/contact" variant="primary">{pagina?.ctaKnoptekst}</Button>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
