---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PortableText from "../components/PortableText.astro";
import { getPagina, getSiteInstellingen } from "../sanity/lib/queries";

const onderwerpen = [
  "Vertalingen & ondertiteling",
  "Privéles Frans of Nederlands",
  "Een recept of wandeling",
  "Franse producten",
  "Iets anders",
];

// Valt terug op de oorspronkelijke tekst zolang het
// site-instellingen-document nog niet bestaat (bv. vóór het seeden).
const [pagina, instellingen] = await Promise.all([getPagina("paginaContact"), getSiteInstellingen()]);
const contactEmail = instellingen?.contactEmail ?? "hallo@saveursavoir.nl";
const reactietijd = instellingen?.reactietijd ?? "Meestal binnen 2 à 3 werkdagen";

const inputClasses =
  "mt-2 w-full border border-blue-300 bg-cream-50 px-4 py-3 text-base text-ink-900 placeholder:text-blue-400 focus:border-terracotta-500 focus:outline-none";
---

<Layout
  title={`${pagina?.paginatitel} — Saveur & Savoir`}
  description="Vraag, idee, of gewoon zin om te praten over Frankrijk? Stuur een bericht."
>
  <Header />

  <Section spacing="lg" tone="cream">
    <Container wide class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
      <div>
        <Eyebrow>{pagina?.paginatitel}</Eyebrow>
        <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
          {pagina?.kop}
        </h1>
        <PortableText value={pagina?.introtekst} class="mt-6 max-w-md text-lg text-ink-500" />
        <dl class="mt-10 space-y-4 text-sm text-ink-700">
          <div>
            <dt class="font-medium text-ink-900">E-mail</dt>
            <dd>{contactEmail}</dd>
          </div>
          <div>
            <dt class="font-medium text-ink-900">Reactietijd</dt>
            <dd>{reactietijd}</dd>
          </div>
        </dl>
      </div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6"
      >
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Nieuw bericht via saveursavoir.nl" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

        <div>
          <label for="naam" class="text-sm font-medium text-ink-900">Naam</label>
          <input id="naam" name="naam" type="text" required class={inputClasses} placeholder="Je volledige naam" />
        </div>

        <div>
          <label for="email" class="text-sm font-medium text-ink-900">E-mail</label>
          <input id="email" name="email" type="email" required class={inputClasses} placeholder="jij@voorbeeld.nl" />
        </div>

        <div>
          <label for="onderwerp" class="text-sm font-medium text-ink-900">Onderwerp</label>
          <input
            id="onderwerp"
            name="onderwerp"
            type="text"
            required
            list="onderwerp-suggesties"
            class={inputClasses}
            placeholder="Bijv. een vertaling, een recept, of een product"
          />
          <datalist id="onderwerp-suggesties">
            {onderwerpen.map((o) => <option value={o} />)}
          </datalist>
        </div>

        <div>
          <label for="bericht" class="text-sm font-medium text-ink-900">Bericht</label>
          <textarea
            id="bericht"
            name="bericht"
            rows={6}
            required
            class={inputClasses}
            placeholder="Vertel me waar je hulp bij zoekt, of wat je kwijt wilt."
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex items-center gap-2 bg-terracotta-500 px-6 py-3 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:bg-terracotta-600"
        >
          Verstuur bericht
        </button>
      </form>
    </Container>
  </Section>

  <Footer />
</Layout>

<script>
  const onderwerp = new URLSearchParams(window.location.search).get("onderwerp");
  const input = document.getElementById("onderwerp");
  if (onderwerp && input instanceof HTMLInputElement) {
    input.value = onderwerp;
  }
</script>
