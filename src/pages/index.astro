---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SanityImage from "../components/SanityImage.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PortableText from "../components/PortableText.astro";
import SpotlightBanner from "../components/SpotlightBanner.astro";
import { getHomepage } from "../sanity/lib/queries";
import { urlFor } from "../sanity/lib/image";
import { getShopifyProducten } from "../shopify/client";

const home = await getHomepage();

// Vaste bestemmingen per aanbod-item — alleen de tekst komt uit Sanity.
const aanbodHrefs = ["/diensten", "/recepten", "/webshop", "/blog"];
const aanbod = (home?.aanbodItems ?? []).map((item, i) => ({
  ...item,
  href: aanbodHrefs[i],
}));

const socialImage = home?.heroAfbeelding
  ? urlFor(home.heroAfbeelding).width(1200).height(630).fit("crop").url()
  : undefined;

// Spotlight-producten: de handles komen uit Sanity, de productdata zelf
// altijd live uit Shopify (nooit uit Sanity gekopieerd). Deze pagina
// blijft statisch (net als recepten/[slug].astro) — een Shopify-wijziging
// triggert een rebuild via de webhook, die dit dan meteen herverifieert.
// Een handle die niet meer bestaat wordt gewoon overgeslagen, nooit een
// dode kaart.
const shopifyProducten = await getShopifyProducten();
const spotlightProducten = (home?.spotlightHandles ?? [])
  .map((handle) => shopifyProducten.find((p) => p.handle === handle))
  .filter((p) => p !== undefined);
---

<Layout
  title={home?.seoTitel || "Saveur & Savoir | Franse recepten, Franse producten, vertalingen & Franse lessen"}
  description={home?.seoOmschrijving}
  image={socialImage}
>
  <!-- Header staat hier los van de hero (niet erin genest): "sticky"
       stopt met werken zodra de sticky-ancestor eindigt, en de hero-
       wrapper hieronder heeft juist een vaste hoogte (min-h-screen).
       Genest zou de header dus alleen tijdens de eerste schermhoogte
       blijven plakken en daarna gewoon wegscrollen. In plaats daarvan:
       header een gewone sticky sibling, en de hero-wrapper op lg+ een
       stukje omhoog (negative margin, exact de headerhoogte) zodat de
       foto er toch achter doorloopt — met evenveel padding-top op de
       tekst erin zodat die niet onder de header verdwijnt. -->
  <Header transparent />

  <!-- Hero. Geen verloop: de foto zelf is al links leeg genoeg voor de
       tekst. Mobiel/tablet: een lange introtekst past niet betrouwbaar
       binnen "min-h-screen" met de foto als achtergrond erachter — de
       foto zou dan te ver onder de tekst wegzakken. Daarom daar een
       vaste-hoogte fotoband bovenaan, gewoon in de leesvolgorde, met de
       tekst eronder (geen overlap met de header nodig, die is daar toch
       niet transparant). -->
  <div class="relative isolate bg-cream-100 text-ink-700 lg:-mt-[82px] lg:flex lg:min-h-screen lg:flex-col">
    <SanityImage
      image={home?.heroAfbeelding}
      ratio="16/9"
      tone="olive"
      class="relative h-64 w-full sm:h-80 lg:absolute lg:inset-0 lg:-z-10 lg:h-full lg:w-full"
      sizes="100vw"
    />

    <div class="lg:flex lg:flex-1 lg:items-center">
      <Container wide class="py-12 lg:py-0">
        <div class="max-w-md">
          <Eyebrow>{home?.heroEyebrow}</Eyebrow>
          <h1 class="mt-6 font-serif text-3xl text-ink-900 sm:text-4xl">
            {home?.heroTitel}
          </h1>
          <PortableText value={home?.heroIntro} class="mt-6 max-w-md text-lg text-ink-700" />
          <div class="mt-10 flex flex-wrap gap-4">
            <Button href="#aanbod" variant="primary">{home?.heroCtaPrimair}</Button>
            <Button href="#over-mij" variant="ghost">{home?.heroCtaSecundair}</Button>
          </div>
        </div>
      </Container>
    </div>
  </div>

  <!-- Spotlight: uitgelichte producten -->
  {
    home && (
      <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
        <SpotlightBanner titel={home.spotlightTitel} producten={spotlightProducten} />
      </Section>
    )
  }

  <!-- Over mij -->
  <Section id="over-mij" spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <SanityImage
        image={home?.overMijAfbeelding}
        ratio="1/1"
        tone="terracotta"
        class="rounded-sm lg:order-1"
      />
      <div class="lg:order-2">
        <Eyebrow>{home?.overMijEyebrow}</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl text-ink-900 sm:text-4xl">
          {home?.overMijTitel}
        </h2>
        <PortableText value={home?.overMijTekst} class="mt-6 max-w-lg text-base text-ink-500" />
        {
          home?.overMijQuote && (
            <p class="mt-4 max-w-lg font-serif text-xl italic text-ink-900">
              "{home.overMijQuote}"
            </p>
          )
        }
      </div>
    </Container>
  </Section>

  <!-- Wat ik bied -->
  <Section id="aanbod" spacing="base" tone="blue" class="border-t border-blue-800">
    <Container wide>
      <Eyebrow class="text-ochre-300">{home?.aanbodEyebrow}</Eyebrow>
      <h2 class="mt-6 max-w-xl font-serif text-3xl text-cream-50 sm:text-4xl">
        {home?.aanbodTitel}
      </h2>

      <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          aanbod.map((item, i) => (
            <a href={item.href} class="group block border-t border-cream-50/20 pt-6 transition-colors hover:border-ochre-300">
              <span class="font-serif text-sm text-ochre-300">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 font-serif text-xl text-cream-50">{item.titel}</h3>
              <PortableText value={item.tekst} class="mt-3 text-sm text-blue-100" />
              <span class="mt-4 inline-block text-xs font-medium tracking-wide text-ochre-300 uppercase group-hover:text-ochre-200">
                Lees meer →
              </span>
            </a>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Contact CTA -->
  <Section id="contact" spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="text-center">
      <Eyebrow class="justify-center">{home?.contactEyebrow}</Eyebrow>
      <h2 class="mx-auto mt-6 max-w-xl font-serif text-3xl text-ink-900 sm:text-4xl">
        {home?.contactTitel}
      </h2>
      <PortableText value={home?.contactTekst} class="mx-auto mt-6 max-w-md text-base text-ink-500" />
      <div class="mt-10">
        <Button href="/contact" variant="primary">{home?.contactCta}</Button>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
