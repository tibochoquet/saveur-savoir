---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SanityImage from "../components/SanityImage.astro";
import PortableText from "../components/PortableText.astro";
import SectieMetBeeld from "../components/SectieMetBeeld.astro";
import { getPaginaVertalingen } from "../sanity/lib/queries";

const pagina = await getPaginaVertalingen();
---

<Layout
  title={`${pagina?.heroTitel} — Saveur & Savoir`}
  description="Frans-Nederlandse vertalingen en ondertiteling, met oog voor toon en nuance."
>
  <Header />

  <Section spacing="lg" tone="cream">
    <Container wide class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <Eyebrow>{pagina?.heroEyebrow}</Eyebrow>
        <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-ink-900 sm:text-5xl">
          {pagina?.heroTitel}
        </h1>
        <PortableText value={pagina?.heroIntro} class="mt-6 max-w-md text-lg text-ink-500" />
        <div class="mt-10">
          <Button href="/contact" variant="primary">{pagina?.heroKnoptekst}</Button>
        </div>
      </div>
      <SanityImage image={pagina?.heroAfbeelding} ratio="4/5" tone="blue" class="rounded-sm" />
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <SectieMetBeeld image={pagina?.watHetIsAfbeelding} ratio="4/3">
        <Eyebrow class="self-start">{pagina?.watHetIsEyebrow}</Eyebrow>
        <PortableText value={pagina?.watHetIsTekst} class="mt-4 max-w-2xl text-base text-ink-700" />
      </SectieMetBeeld>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container wide>
      <Eyebrow>{pagina?.voorWieEyebrow}</Eyebrow>
      <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-3">
        {
          pagina?.voorWieItems.map((item) => (
            <div class="border-t border-blue-200 pt-6">
              <h3 class="font-serif text-xl text-ink-900">{item.titel}</h3>
              <PortableText value={item.tekst} class="mt-3 text-sm text-ink-500" />
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="blue" class="border-t border-blue-800">
    <Container wide>
      <Eyebrow class="text-ochre-300">{pagina?.hoeHetWerktEyebrow}</Eyebrow>
      <div class="mt-10 divide-y divide-cream-50/20">
        {
          pagina?.hoeHetWerktStappen.map((stap, i) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8">
              <span class="w-10 shrink-0 font-serif text-sm text-ochre-300">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="w-full shrink-0 font-serif text-lg text-cream-50 sm:w-56">{stap.titel}</h3>
              <PortableText value={stap.tekst} class="text-sm text-blue-100" />
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section spacing="base" tone="cream" class="border-t border-blue-200/70">
    <Container class="text-center">
      <Eyebrow class="justify-center">{pagina?.ctaEyebrow}</Eyebrow>
      <h2 class="mx-auto mt-6 max-w-xl font-serif text-3xl text-ink-900 sm:text-4xl">
        {pagina?.ctaTitel}
      </h2>
      <PortableText value={pagina?.ctaTekst} class="mx-auto mt-6 max-w-md text-base text-ink-500" />
      <div class="mt-10">
        <Button href="/contact" variant="primary">{pagina?.ctaKnoptekst}</Button>
      </div>
    </Container>
  </Section>

  <Footer />
</Layout>
