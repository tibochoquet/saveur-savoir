---
// Stand-in for real photography. Renders an aspect-ratio-correct
// placeholder so layouts can be judged before assets exist.
interface Props {
  ratio?: string;
  tone?: "terracotta" | "olive" | "blue" | "ochre";
  label?: string;
  class?: string;
}

const { ratio = "4/5", tone = "olive", label = "Beeld volgt", class: className = "" } = Astro.props;

const tones = {
  terracotta: { from: "#c3623c", to: "#a44c2c" },
  olive: { from: "#8d8a48", to: "#5a5a30" },
  blue: { from: "#5c7f86", to: "#364e55" },
  ochre: { from: "#c99936", to: "#8b6522" },
} as const;

const { from, to } = tones[tone];
const gradientId = `ph-${tone}-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={["relative overflow-hidden", className]}
  style={`aspect-ratio: ${ratio};`}
>
  <svg class="h-full w-full" preserveAspectRatio="none" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={label}>
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={from} />
        <stop offset="100%" stop-color={to} />
      </linearGradient>
      <pattern id={`grain-${gradientId}`} width="6" height="6" patternUnits="userSpaceOnUse">
        <rect width="6" height="6" fill="transparent" />
        <circle cx="1" cy="1" r="0.6" fill="#000" opacity="0.04" />
      </pattern>
    </defs>
    <rect width="400" height="400" fill={`url(#${gradientId})`} />
    <rect width="400" height="400" fill={`url(#grain-${gradientId})`} />
  </svg>
  <span
    class="pointer-events-none absolute bottom-4 left-4 text-xs font-medium tracking-[0.15em] uppercase text-cream-50/80"
  >
    {label}
  </span>
</div>
