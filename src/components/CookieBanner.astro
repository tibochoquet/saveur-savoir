---
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<div
  id="cookie-banner"
  data-ga-id={gaId ?? ""}
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-blue-200 bg-cream-50 p-6 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] sm:p-8"
>
  <div class="mx-auto max-w-4xl">
    <!-- Standaardweergave: accepteren / weigeren / voorkeuren -->
    <div id="cookie-banner-summary" class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-sm text-ink-700">
        We gebruiken alleen analytische cookies (Google Analytics) als je daar toestemming voor geeft. Zonder
        toestemming meten we niets. Lees meer op de{" "}
        <a href="/cookievoorkeuren" class="text-blue-500 underline hover:text-terracotta-500">Cookievoorkeuren</a>-pagina.
      </p>
      <div class="flex shrink-0 flex-wrap gap-3">
        <button
          type="button"
          id="cookie-decline"
          class="border border-blue-400 bg-transparent px-5 py-2.5 text-sm font-medium tracking-wide text-blue-700 uppercase transition-colors duration-200 hover:bg-blue-50"
        >
          Weigeren
        </button>
        <button
          type="button"
          id="cookie-preferences-open"
          class="border border-transparent bg-transparent px-5 py-2.5 text-sm font-medium tracking-wide text-ink-900 underline decoration-ochre-400 decoration-2 uppercase transition-colors duration-200 hover:decoration-terracotta-500"
        >
          Voorkeuren
        </button>
        <button
          type="button"
          id="cookie-accept"
          class="border border-terracotta-500 bg-terracotta-500 px-5 py-2.5 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:border-terracotta-600 hover:bg-terracotta-600"
        >
          Accepteren
        </button>
      </div>
    </div>

    <!-- Voorkeurenpaneel -->
    <div id="cookie-banner-preferences" hidden class="flex flex-col gap-6">
      <div class="flex items-start justify-between gap-4 border-b border-blue-200/70 pb-4">
        <div>
          <p class="text-sm font-medium text-ink-900">Noodzakelijke cookies</p>
          <p class="mt-1 text-sm text-ink-500">
            Altijd actief — bv. de winkelwagen-cookie van Shopify zodra je iets aan je winkelwagen toevoegt. Kan
            niet uitgezet worden.
          </p>
        </div>
        <span class="mt-0.5 shrink-0 text-xs font-medium tracking-wide text-ink-500 uppercase">Altijd aan</span>
      </div>

      <div class="flex items-start justify-between gap-4 pb-2">
        <div>
          <p class="text-sm font-medium text-ink-900">Analytische cookies</p>
          <p class="mt-1 text-sm text-ink-500">
            Google Analytics — helpt ons begrijpen hoe bezoekers de site gebruiken. Wordt alleen geplaatst met jouw
            toestemming.
          </p>
        </div>
        <button
          type="button"
          id="cookie-analytics-toggle"
          role="switch"
          aria-checked="false"
          class="relative mt-0.5 h-6 w-11 shrink-0 rounded-full border border-blue-300 bg-cream-100 transition-colors duration-200 data-[checked=true]:border-terracotta-500 data-[checked=true]:bg-terracotta-500"
        >
          <span class="absolute top-0.5 left-0.5 h-4 w-4 rounded-full bg-white transition-transform duration-200 [[data-checked=true]_&]:translate-x-5"></span>
        </button>
      </div>

      <div class="flex flex-wrap justify-end gap-3">
        <button
          type="button"
          id="cookie-preferences-cancel"
          class="border border-transparent bg-transparent px-5 py-2.5 text-sm font-medium tracking-wide text-ink-700 uppercase transition-colors duration-200 hover:text-terracotta-500"
        >
          Annuleren
        </button>
        <button
          type="button"
          id="cookie-preferences-save"
          class="border border-terracotta-500 bg-terracotta-500 px-5 py-2.5 text-sm font-medium tracking-wide text-cream-50 uppercase transition-colors duration-200 hover:border-terracotta-600 hover:bg-terracotta-600"
        >
          Voorkeuren opslaan
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { applyConsent, getStoredConsent } from "../lib/consent";

  const banner = document.getElementById("cookie-banner") as HTMLElement;
  const gaId = banner.dataset.gaId || undefined;

  const summary = document.getElementById("cookie-banner-summary") as HTMLElement;
  const preferences = document.getElementById("cookie-banner-preferences") as HTMLElement;
  const toggle = document.getElementById("cookie-analytics-toggle") as HTMLButtonElement;

  function setToggle(checked: boolean) {
    toggle.dataset.checked = String(checked);
    toggle.setAttribute("aria-checked", String(checked));
  }

  function showBanner() {
    banner.hidden = false;
  }
  function hideBanner() {
    banner.hidden = true;
  }
  function showSummary() {
    summary.hidden = false;
    preferences.hidden = true;
  }
  function showPreferences() {
    setToggle(getStoredConsent() === "granted");
    summary.hidden = true;
    preferences.hidden = false;
    showBanner();
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    applyConsent("granted", gaId);
    hideBanner();
  });
  document.getElementById("cookie-decline")?.addEventListener("click", () => {
    applyConsent("denied", gaId);
    hideBanner();
  });
  document.getElementById("cookie-preferences-open")?.addEventListener("click", showPreferences);
  document.getElementById("cookie-preferences-cancel")?.addEventListener("click", () => {
    if (getStoredConsent() === null) {
      showSummary();
    } else {
      hideBanner();
    }
  });
  toggle?.addEventListener("click", () => setToggle(toggle.dataset.checked !== "true"));
  document.getElementById("cookie-preferences-save")?.addEventListener("click", () => {
    applyConsent(toggle.dataset.checked === "true" ? "granted" : "denied", gaId);
    hideBanner();
  });

  // Nog geen keuze gemaakt op deze (of een eerdere) pagina-load: toon de banner.
  if (getStoredConsent() === null) {
    showSummary();
    showBanner();
  }

  // Herroepbaar vanaf de Cookievoorkeuren-pagina.
  window.addEventListener("open-cookie-preferences", showPreferences);
</script>
