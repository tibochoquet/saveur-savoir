---
import Container from "./Container.astro";

interface Props {
  // Alleen gebruikt op de homepage: header zonder eigen achtergrond op
  // lg+, zodat de hero-foto erachter zichtbaar blijft. Op mobiel/tablet
  // altijd de gewone cream balk (daar staat geen foto achter de header).
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Webshop", href: "/webshop" },
  { label: "Diensten", href: "/diensten" },
  { label: "Recepten", href: "/recepten" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];

const { pathname } = Astro.url;
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header
  data-transparent={transparent ? "true" : undefined}
  class:list={[
    "sticky top-0 z-50 border-b border-blue-200/70 bg-cream-100",
    transparent && "lg:border-transparent lg:bg-transparent",
  ]}
>
  <Container wide class="flex items-center justify-between py-6">
    <a href="/" class="flex flex-shrink-0 items-center">
      <img
        src="/logo/wordmark.svg"
        alt="Saveur &amp; Savoir"
        width="184"
        height="18"
        loading="eager"
        class="hidden h-[18px] w-auto flex-shrink-0 sm:block xl:h-[24px]"
      />
      <img
        src="/logo/icon.svg"
        alt="Saveur &amp; Savoir"
        width="44"
        height="35"
        loading="eager"
        class="block h-9 w-auto sm:hidden"
      />
    </a>

    <nav class="hidden items-center gap-8 text-base font-medium tracking-wide text-ink-700 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              item.label === "Webshop"
                ? "text-lg font-bold text-terracotta-500 hover:text-terracotta-600"
                : "hover:text-terracotta-500",
              item.label !== "Webshop" && isActive(item.href) ? "text-terracotta-500" : "",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4 lg:gap-0">
      <a
        href="/winkelwagen"
        id="cart-link"
        class="flex items-center gap-1.5 text-base font-medium tracking-wide text-ink-700 hover:text-terracotta-500 lg:ml-8 lg:border-l lg:border-blue-200/70 lg:pl-8"
        aria-label="Winkelwagen"
      >
        Winkelwagen
        <span
          id="cart-count"
          class="hidden min-w-5 items-center justify-center rounded-full bg-terracotta-500 px-1.5 py-0.5 text-xs font-semibold text-cream-50"
        >0</span>
      </a>

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex flex-col gap-1.5 p-2 lg:hidden"
      >
        <span class="sr-only">Menu</span>
        <span class="h-px w-6 bg-ink-900 transition-transform"></span>
        <span class="h-px w-6 bg-ink-900 transition-opacity"></span>
        <span class="h-px w-6 bg-ink-900 transition-transform"></span>
      </button>
    </div>
  </Container>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-1 border-t border-blue-200/70 bg-cream-100 px-6 py-4 lg:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "py-3",
            item.label === "Webshop"
              ? "text-lg font-bold text-terracotta-500"
              : [
                  "text-base font-medium",
                  isActive(item.href) ? "text-terracotta-500" : "text-ink-700",
                ],
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  import { getCartCount } from "../shopify/cart";

  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    panel?.classList.toggle("hidden");
    panel?.classList.toggle("flex");
  });

  const cartCountEl = document.getElementById("cart-count");
  function renderCartCount(count: number) {
    if (!cartCountEl) return;
    cartCountEl.textContent = String(count);
    cartCountEl.classList.toggle("hidden", count === 0);
    cartCountEl.classList.toggle("inline-flex", count > 0);
  }

  getCartCount()
    .then(renderCartCount)
    .catch(() => renderCartCount(0));

  window.addEventListener("cart:updated", (event) => {
    renderCartCount((event as CustomEvent<{ count: number }>).detail.count);
  });

  // Transparante header (alleen op de homepage, zie de "transparent"-prop):
  // de header is sticky en blijft dus zichtbaar tijdens het scrollen, ook
  // nadat de hero-foto allang voorbij is. Zonder dit zou de header daar
  // een onleesbare doorzichtige balk over de rest van de pagina worden.
  const header = document.querySelector<HTMLElement>("header[data-transparent]");
  if (header) {
    function updateHeaderBackground() {
      const scrolled = window.scrollY > 40;
      header!.classList.toggle("lg:bg-cream-100", scrolled);
      header!.classList.toggle("lg:border-blue-200/70", scrolled);
      header!.classList.toggle("lg:bg-transparent", !scrolled);
      header!.classList.toggle("lg:border-transparent", !scrolled);
    }

    updateHeaderBackground();
    window.addEventListener("scroll", updateHeaderBackground, { passive: true });
  }
</script>
