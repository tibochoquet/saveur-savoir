---
import Container from "./Container.astro";
import { getSiteInstellingen } from "../sanity/lib/queries";

// Valt terug op de oorspronkelijke tekst zolang het
// site-instellingen-document nog niet bestaat (bv. vóór het seeden).
const instellingen = await getSiteInstellingen();
const footerTagline = instellingen?.footerTagline ?? "Frans leven, taal en landschap — met tijd genomen.";
const footerRegel = instellingen?.footerRegel ?? "Gevestigd in Nederland, met het hart in Frankrijk.";

// De URL's liggen vast in code; alleen de zichtbare labels komen uit
// siteInstellingen.
const columns = [
  {
    heading: instellingen?.footerDiensten?.titel ?? "Diensten",
    links: [
      { label: instellingen?.footerDiensten?.link1Label ?? "Vertalingen & ondertiteling", href: "/vertalingen" },
      { label: instellingen?.footerDiensten?.link2Label ?? "Privéles Frans & Nederlands", href: "/prive-les" },
    ],
  },
  {
    heading: instellingen?.footerOntdekken?.titel ?? "Ontdekken",
    links: [
      { label: instellingen?.footerOntdekken?.link1Label ?? "Franse recepten", href: "/recepten" },
      { label: instellingen?.footerOntdekken?.link2Label ?? "Webshop", href: "/webshop" },
      { label: instellingen?.footerOntdekken?.link3Label ?? "Blog", href: "/blog" },
    ],
  },
];

const contactHeading = instellingen?.footerContact?.titel ?? "Contact";
const contactLinkLabel = instellingen?.footerContact?.link1Label ?? "Stuur een bericht";

// Vaste juridische links — elke link wijst naar zijn eigen pagina. Alle
// 7 juridische pagina's staan hier, ook Algemene voorwaarden en
// Servicevoorwaarden die daarnaast ook nog op de contactpagina staan —
// de footer is de plek waar bezoekers een juridische link het eerst
// zoeken, dus geen enkele mag hier ontbreken.
const juridischeLinks = [
  { label: "Disclaimer", href: "/disclaimer" },
  { label: "Algemene voorwaarden", href: "/algemene-voorwaarden" },
  { label: "Servicevoorwaarden", href: "/servicevoorwaarden" },
  { label: "Cookievoorkeuren", href: "/cookievoorkeuren" },
  { label: "Privacybeleid", href: "/privacybeleid" },
  { label: "Herroeping", href: "/herroeping" },
  { label: "Verzenden & Retourneren", href: "/verzenden-retourneren" },
];
---

<footer class="border-t border-blue-200/70 bg-cream-50">
  <Container wide class="py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="font-serif text-xl text-ink-900">Saveur &amp; Savoir</a>
        <p class="mt-4 max-w-xs text-sm text-ink-500">
          {footerTagline}
        </p>
      </div>

      {
        columns.map((column) => (
          <div>
            <h3 class="text-xs font-semibold tracking-[0.15em] text-blue-500 uppercase">
              {column.heading}
            </h3>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-ink-700 hover:text-terracotta-500">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h3 class="text-xs font-semibold tracking-[0.15em] text-blue-500 uppercase">{contactHeading}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/contact" class="text-sm text-ink-700 hover:text-terracotta-500">{contactLinkLabel}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-blue-200/70 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-2 text-xs text-ink-500 sm:flex-row sm:gap-6">
        <span>&copy; {new Date().getFullYear()} Saveur &amp; Savoir</span>
        <span>{footerRegel}</span>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-ink-500">
        {
          juridischeLinks.map((link) => (
            <a href={link.href} class="hover:text-terracotta-500">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</footer>
