---
// Shared by /recepten, /wandelen, /blog and /franse-producten so the
// overview grids use one layout instead of four near-identical ones.
import SanityImage from "./SanityImage.astro";
import type { SanityImageValue } from "../sanity/lib/types";

interface Props {
  href: string | null;
  eyebrow: string;
  title: string;
  excerpt: string;
  meta?: string;
  prijs?: string;
  image?: SanityImageValue | null;
  imageUrl?: string | null;
  imageAlt?: string;
  tone?: "terracotta" | "olive" | "blue" | "ochre";
  ratio?: string;
  dataCategory?: string;
}

const {
  href,
  eyebrow,
  title,
  excerpt,
  meta,
  prijs,
  image,
  imageUrl,
  imageAlt = "",
  tone = "olive",
  ratio = "4/3",
  dataCategory,
} = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  href={href ?? undefined}
  data-category={dataCategory}
  class:list={["group block", href && "cursor-pointer"]}
>
  {
    imageUrl ? (
      <div class="relative w-full overflow-hidden rounded-sm" style={`aspect-ratio: ${ratio};`}>
        <img
          src={imageUrl}
          alt={imageAlt}
          width="800"
          height="600"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    ) : (
      <SanityImage image={image} ratio={ratio} tone={tone} class="rounded-sm" />
    )
  }
  <div class="mt-5">
    <span class="text-xs font-semibold tracking-[0.15em] text-terracotta-500 uppercase">
      {eyebrow}
    </span>
    <h3 class="mt-2 font-serif text-xl text-ink-900 group-hover:text-terracotta-600">
      {title}
      {!href && (
        <span class="ml-2 align-middle text-xs font-sans font-medium tracking-wide text-blue-400 uppercase">
          Binnenkort
        </span>
      )}
    </h3>
    {prijs && <p class="mt-1 font-serif text-lg text-terracotta-600">{prijs}</p>}
    <p class="mt-2 text-sm text-ink-500">{excerpt}</p>
    {meta && <p class="mt-3 text-xs tracking-wide text-blue-500 uppercase">{meta}</p>}
  </div>
</Tag>
